rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated and uid matches userId
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection: owner-only access
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Profile subcollection
      match /profile/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Wishlist subcollection
      match /wishlist/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // Decisions subcollection
      match /decisions/{decisionId} {
        allow read, write: if isOwner(userId);
      }

      // Digests subcollection
      match /digests/{digestId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }
  }
}
